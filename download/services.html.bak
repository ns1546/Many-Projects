                <h2 class="font-display font-extrabold text-2xl sm:text-4xl uppercase tracking-tight text-white mb-4">Project Scope Estimator</h2>
                <p class="font-sans text-xs sm:text-sm text-gray-400">Click options below to customize your production requirements and generate an instant booking briefing.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Controls Column -->
                <div class="lg:col-span-2 space-y-8 bento-border p-6 md:p-8">
                    <!-- Step 1: Select Service -->
                    <div>
                        <label class="block font-sans text-xs uppercase tracking-widest font-bold text-gray-300 mb-3">1. Select Required Production Craft</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                            <button type="button" class="interactive-pill selected px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="service" data-value="ost" data-base="35000">Drama OST</button>
                            <button type="button" class="interactive-pill px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="service" data-value="bgm" data-base="25000">Film BGM</button>
                            <button type="button" class="interactive-pill px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="service" data-value="vocal" data-base="15000">Vocal Booth</button>
                            <button type="button" class="interactive-pill px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="service" data-value="mix" data-base="18000">Mix & Master</button>
                        </div>
                    </div>

                    <!-- Step 2: Project Scope -->
                    <div>
                        <label class="block font-sans text-xs uppercase tracking-widest font-bold text-gray-300 mb-3">2. Project Scope & Stems</label>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                            <button type="button" class="interactive-pill selected px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="scope" data-value="standard" data-multiplier="1.0">Standard (Stereo Master)</button>
                            <button type="button" class="interactive-pill px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="scope" data-value="stems" data-multiplier="1.3">Broadcast (Full Stems)</button>
                            <button type="button" class="interactive-pill px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="scope" data-value="series" data-multiplier="2.2">Multi-Track Series</button>
                        </div>
                    </div>

                    <!-- Step 3: Turnaround Urgency -->
                    <div>
                        <label class="block font-sans text-xs uppercase tracking-widest font-bold text-gray-300 mb-3">3. Delivery Schedule</label>
                        <div class="grid grid-cols-2 gap-2.5">
                            <button type="button" class="interactive-pill selected px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="timeline" data-value="standard" data-extra="0">Standard Schedule (5-7 Days)</button>
                            <button type="button" class="interactive-pill px-3 py-2.5 rounded-xl border border-white/10 bg-white/5 font-sans text-xs font-bold text-white text-center" data-type="timeline" data-value="priority" data-extra="8000">Priority Express (48 Hours)</button>
                        </div>
                    </div>
                </div>

                <!-- Live Summary Column -->
                <div class="bento-border p-6 md:p-8 flex flex-col justify-between bg-black/60 relative">
                    <div class="space-y-6">
                        <div class="border-b border-white/10 pb-4">
                            <span class="font-sans text-[10px] uppercase tracking-widest text-gray-400 block mb-1">Configuration Overview</span>
                            <h3 id="estimator-selection" class="font-display text-lg font-bold uppercase text-white">Drama OST (Standard)</h3>
                        </div>

                        <div class="space-y-3 font-sans text-xs">
                            <div class="flex justify-between text-gray-400">
                                <span>Core Production:</span>
                                <strong id="estimator-craft-name" class="text-white">Drama OST</strong>
                            </div>
                            <div class="flex justify-between text-gray-400">
                                <span>Deliverable Package:</span>
                                <strong id="estimator-scope-name" class="text-white">Stereo Master</strong>
                            </div>
                            <div class="flex justify-between text-gray-400">
                                <span>Turnaround Window:</span>
                                <strong id="estimator-time-name" class="text-white">5–7 Days</strong>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-white/10">
                            <span class="font-sans text-[10px] uppercase tracking-widest text-accent font-bold block mb-1">Estimated Budget Range</span>
                            <div class="flex items-baseline gap-2">
                                <span class="font-display font-extrabold text-3xl sm:text-4xl text-white" id="estimator-price">35,000</span>
                                <span class="font-sans text-xs text-gray-400 font-bold uppercase">BDT (Approx)</span>
                            </div>
                            <p class="font-sans text-[11px] text-gray-500 mt-1">Final scope confirmed after audio script/reference review.</p>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-white/10 mt-6 space-y-3">
                        <a id="estimator-wa-btn" href="https://wa.me/8801938172454?text=Hello%20JKH%20Jesan,%20I%20would%20like%20to%20book%20a%20Drama%20OST%20project." target="_blank" class="w-full block text-center py-3.5 rounded-full bg-accent text-white font-sans text-xs font-bold uppercase tracking-widest hover:brightness-110 transition-all shadow-[0_0_20px_rgba(255,69,0,0.4)]">
                            <i class="fab fa-whatsapp mr-1.5"></i> Lock Date on WhatsApp
                        </a>
                        <a href="contact.html" class="w-full block text-center py-2.5 rounded-full border border-white/20 text-gray-300 font-sans text-xs font-bold uppercase tracking-widest hover:border-white hover:text-white transition-colors">
                            Submit Detailed Brief
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. DELIVERABLES & TECHNICAL SPECIFICATIONS -->
    <section class="py-16 md:py-24 px-4 md:px-12 relative z-20">
        <div class="container mx-auto max-w-[1300px]">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bento-border p-6 gs-reveal">
                    <div class="text-accent text-2xl mb-4"><i class="fas fa-file-audio"></i></div>
                    <h3 class="font-display text-base font-bold uppercase text-white mb-2">Master Deliverables</h3>
                    <p class="font-sans text-xs text-gray-400 leading-relaxed mb-3">Every approved master arrives in high-resolution uncompressed 24-bit 48kHz WAV, ready for TV broadcast and OTT encoding.</p>
                    <span class="font-sans text-[10px] text-accent font-bold uppercase tracking-wider">• 24-bit / 48kHz Broadcast WAV</span><br>
                    <span class="font-sans text-[10px] text-accent font-bold uppercase tracking-wider">• 320kbps MP3 Reference</span>
                </div>

                <div class="bento-border p-6 gs-reveal">
                    <div class="text-accent text-2xl mb-4"><i class="fas fa-sliders"></i></div>
                    <h3 class="font-display text-base font-bold uppercase text-white mb-2">Multi-Track Stems</h3>
                    <p class="font-sans text-xs text-gray-400 leading-relaxed mb-3">Structured stem packages for video editors, television audio boards, live performance playback, and synchronization licensing.</p>
                    <span class="font-sans text-[10px] text-accent font-bold uppercase tracking-wider">• TV Broadcast / Dialogue-Dip Mix</span><br>
                    <span class="font-sans text-[10px] text-accent font-bold uppercase tracking-wider">• Instrumental & Acapella Isolations</span>
                </div>

                <div class="bento-border p-6 gs-reveal">
                    <div class="text-accent text-2xl mb-4"><i class="fas fa-shield-halved"></i></div>
                    <h3 class="font-display text-base font-bold uppercase text-white mb-2">Rights & Revisions</h3>
                    <p class="font-sans text-xs text-gray-400 leading-relaxed mb-3">Clear commercial publishing rights for television drama, YouTube content ID, cinema release, and Spotify streaming distribution.</p>
                    <span class="font-sans text-[10px] text-accent font-bold uppercase tracking-wider">• 2 Comprehensive Revision Rounds Included</span><br>
                    <span class="font-sans text-[10px] text-accent font-bold uppercase tracking-wider">• 100% Cleared Original Audio Stems</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. INTERACTIVE FAQ ACCORDION -->
    <section class="py-16 md:py-24 px-4 md:px-12 relative z-20 bg-surface/30 border-t border-white/5">
        <div class="container mx-auto max-w-[1000px]">
            <div class="text-center mb-12 gs-reveal">
                <span class="font-sans text-[9px] uppercase tracking-[0.4em] font-bold text-accent mb-2 block">Common Questions</span>
                <h2 class="font-display font-extrabold text-2xl sm:text-4xl uppercase tracking-tight text-white">Production FAQ</h2>
            </div>

            <div class="space-y-4" id="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item p-5 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h4 class="font-display text-sm md:text-base font-bold text-white uppercase">How do remote production bookings work?</h4>
                        <i class="fas fa-chevron-down text-accent text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-body hidden pt-3 font-sans text-xs text-gray-400 leading-relaxed border-t border-white/5 mt-3">
                        We work seamlessly with directors and artists worldwide. You can share your drama script, visual video cuts (timecoded MP4/ProRes), and reference tracks via Google Drive/WeTransfer. Review sessions are held via high-bitrate streaming or WhatsApp calls.
                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="faq-item p-5 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h4 class="font-display text-sm md:text-base font-bold text-white uppercase">Can I book vocal tracking at the Niketon studio?</h4>
                        <i class="fas fa-chevron-down text-accent text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-body hidden pt-3 font-sans text-xs text-gray-400 leading-relaxed border-t border-white/5 mt-3">
                        Yes! The vocal booth is located in Niketon, Gulshan, Dhaka. Sessions must be scheduled at least 48 hours in advance to ensure acoustic calibration and engineer availability. Contact us via WhatsApp to confirm calendar slots.
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="faq-item p-5 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h4 class="font-display text-sm md:text-base font-bold text-white uppercase">What deliverables are provided for broadcast television?</h4>
                        <i class="fas fa-chevron-down text-accent text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-body hidden pt-3 font-sans text-xs text-gray-400 leading-relaxed border-t border-white/5 mt-3">
                        For television drama and cinema, you receive loudness-compliant masters tuned to -23 / -24 LUFS, full instrumental stems, dialogue-friendly dip tracks, and high-energy promo cutdowns for teasers and social reels.
                    </div>
                </div>

                <!-- FAQ 4 -->
                <div class="faq-item p-5 cursor-pointer" onclick="toggleFaq(this)">
                    <div class="flex items-center justify-between">
                        <h4 class="font-display text-sm md:text-base font-bold text-white uppercase">How are revisions and mix adjustments handled?</h4>
                        <i class="fas fa-chevron-down text-accent text-xs transition-transform duration-300"></i>
                    </div>
                    <div class="faq-body hidden pt-3 font-sans text-xs text-gray-400 leading-relaxed border-t border-white/5 mt-3">
                        Every project includes 2 full revision rounds where you can fine-tune instrumentation, vocal balance, and dynamic pacing. Minor master volume tweaks are always addressed promptly.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. FOOTER CTA -->
    <section class="min-h-[50vh] flex flex-col justify-between pt-16 md:pt-24 px-4 md:px-12 bg-white text-black relative z-30">
        <div class="container mx-auto max-w-[1500px] flex-grow flex flex-col justify-center text-center gs-reveal">
            <p class="font-sans font-bold text-[clamp(8px,1vw,12px)] uppercase tracking-[0.4em] text-gray-400 mb-4">Start Your Production</p>
            <a href="contact.html" class="hover-flip" data-text="START A PROJECT">
                <span class="font-display font-extrabold text-[clamp(2.5rem,8vw,7rem)] leading-[0.85] uppercase tracking-tighter text-black mix-blend-difference break-words block px-4">START A PROJECT</span>
            </a>
        </div>
        <div class="w-full py-8 border-t border-black/10 flex flex-col md:flex-row justify-between items-center text-[10px] font-bold uppercase tracking-[0.2em] font-sans text-gray-500 relative">
            <p>&copy; 2026 JKH JESAN</p>
            <a href="admin.html" class="opacity-20 hover:opacity-100 transition-all duration-500 transform hover:scale-110 hover:text-accent cursor-pointer group flex items-center gap-2">
                <i class="fas fa-lock text-[8px] group-hover:animate-pulse"></i> Sys
            </a>
        </div>
    </section>

    <!-- Interactive Script for Estimator & FAQ -->
    <script>
        // Smooth Lenis Scroll
        const lenis = new Lenis({
            duration: 1.1,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
            touchMultiplier: 1.6
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => { lenis.raf(time * 1000); });
        gsap.ticker.lagSmoothing(0);
        gsap.registerPlugin(ScrollTrigger);

        // GSAP Reveal
        gsap.utils.toArray('.gs-reveal').forEach(elem => {
            gsap.fromTo(elem, { y: 50, opacity: 0 }, { y: 0, opacity: 1, duration: 1.1, ease: "power3.out", scrollTrigger: { trigger: elem, start: "top 88%" } });
        });

        // Interactive Cost Estimator State
        let currentCraft = { name: "Drama OST", base: 35000 };
        let currentScope = { name: "Stereo Master", mult: 1.0 };
        let currentTime = { name: "5–7 Days", extra: 0 };

        document.querySelectorAll('.interactive-pill').forEach(btn => {
            btn.addEventListener('click', function() {
                const type = this.getAttribute('data-type');
                document.querySelectorAll(`.interactive-pill[data-type="${type}"]`).forEach(b => b.classList.remove('selected'));
                this.classList.add('selected');

                if (type === 'service') {
                    currentCraft.name = this.innerText;
                    currentCraft.base = parseInt(this.getAttribute('data-base')) || 35000;
                } else if (type === 'scope') {
                    currentScope.name = this.innerText.split('(')[0].trim();
                    currentScope.mult = parseFloat(this.getAttribute('data-multiplier')) || 1.0;
                } else if (type === 'timeline') {
                    currentTime.name = this.innerText.includes('Priority') ? '48 Hours' : '5–7 Days';
                    currentTime.extra = parseInt(this.getAttribute('data-extra')) || 0;
                }

                updateEstimator();
            });
        });

        function updateEstimator() {
            const total = Math.round((currentCraft.base * currentScope.mult) + currentTime.extra);
            document.getElementById('estimator-price').innerText = total.toLocaleString();
            document.getElementById('estimator-selection').innerText = `${currentCraft.name} (${currentScope.name})`;
            document.getElementById('estimator-craft-name').innerText = currentCraft.name;
            document.getElementById('estimator-scope-name').innerText = currentScope.name;
            document.getElementById('estimator-time-name').innerText = currentTime.name;

            const waText = encodeURIComponent(`Hello JKH Jesan,\nI would like to inquire about booking:\n• Service: ${currentCraft.name}\n• Scope: ${currentScope.name}\n• Timeline: ${currentTime.name}\n• Approx Estimate: ${total.toLocaleString()} BDT\n\nPlease let me know your available slots.`);
            document.getElementById('estimator-wa-btn').href = `https://wa.me/8801938172454?text=${waText}`;
        }

        // FAQ Toggle
        function toggleFaq(card) {
            const body = card.querySelector('.faq-body');
            const icon = card.querySelector('i');
            const isOpen = card.classList.contains('open');

            document.querySelectorAll('.faq-item').forEach(item => {
                item.classList.remove('open');
                item.querySelector('.faq-body').classList.add('hidden');
                item.querySelector('i').style.transform = 'rotate(0deg)';
            });

            if (!isOpen) {
                card.classList.add('open');
                body.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            }
        }
    </script>
    <script src="mobile.js"></script>
</body>

</html>
