{
  "name": "evorise-restaurant-admin",
  "version": "2.0.0",
  "main": "desktop/main.js",
  "author": "Evorise Solution",
  "description": "Enterprise Restaurant POS & Kitchen Management Desktop Software",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build:desktop": "electron-packager . \"Evorise-Restaurant-Admin\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/(dist|docs|tests|\\.agents|\\.git)\"",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.evorise.restaurant.admin",
    "productName": "Evorise Restaurant Admin",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Evorise Restaurant Admin",
      "runAfterFinish": true
    },
    "files": [
      "desktop/**/*",
      "backend/**/*",
      "admin/**/*",
      "server.js",
      "db.js",
      "auth.js",
      "database.sqlite",
      "index.html",
      "index.css",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist-installer"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
